<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required for battery optimisation exemption request -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Block &amp; Filter"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!--
            Main settings screen.
            IMPORTANT:
            Do NOT add MAIN / LAUNCHER intent filter here.
            Launcher exposure is controlled only by LauncherAlias.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true" />

        <!--
            Launcher icon entry.
            MainActivity enables/disables this component when
            Hide App Icon / Show App Icon is selected.
        -->
        <activity-alias
            android:name=".LauncherAlias"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="Block &amp; Filter"
            android:targetActivity=".MainActivity">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity-alias>

        <!-- Reels / Shorts blocker -->
        <service
            android:name=".BlockerAccessibilityService"
            android:exported="true"
            android:label="Block &amp; Filter"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">

            <intent-filter>
                <action
                    android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />

        </service>

        <!-- Parental Protection / Device Admin -->
        <receiver
            android:name=".BlockFilterAdminReceiver"
            android:description="@string/device_admin_description"
            android:exported="true"
            android:label="Block &amp; Filter"
            android:permission="android.permission.BIND_DEVICE_ADMIN">

            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />

            <intent-filter>
                <action
                    android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>

        </receiver>

    </application>

</manifest>
